# mdpage — Environment configuration example
# Copy this file to .env and adjust values.
# See ENV.md for full documentation of each variable.

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3456
NODE_ENV=production

# ── Lifecycle engine ──────────────────────────────────────────────────────────
# Days before a free article enters lifecycle evaluation
LC_MIN_AGE_DAYS=30

# Min 30-day unique visitors to stay "healthy"
LC_UNIQUE_VIEW_THRESHOLD=10

# Days at-risk before the article expires
LC_AT_RISK_WINDOW_DAYS=7

# Sweep interval in milliseconds (default 24h = 86400000)
LIFECYCLE_INTERVAL_MS=86400000

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Publish: max 5 requests per IP per hour
RATE_PUBLISH_MAX=5
RATE_PUBLISH_WIN=3600

# View recording: max 60 requests per IP per minute
RATE_VIEW_MAX=60
RATE_VIEW_WIN=60

# ── Logging ───────────────────────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=info

# ── Internal dashboard ───────────────────────────────────────────────────────
# Token required to access /internal and all /api/internal/* routes.
# Leave unset (or empty) for open access in dev/local environments.
# In production: set a long random secret, e.g. `openssl rand -hex 32`
# INTERNAL_DASHBOARD_TOKEN=changeme

# ── Billing (Phase 2) ────────────────────────────────────────────────────────
# Provider: 'stripe' or 'none' (default). Set to 'stripe' to enable payment flows.
# BILLING_PROVIDER=stripe

# Stripe keys — obtain from https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe price ID for the paid plan (preferred over BILLING_AMOUNT_CENTS)
# BILLING_PAID_PRICE_ID=price_...

# One-time fallback amount in cents when no price ID is set (default: 900 = $9.00)
# BILLING_AMOUNT_CENTS=900

# Currency (ISO-4217, default: usd)
# BILLING_CURRENCY=usd

# Redirect URLs after checkout
# BILLING_SUCCESS_URL=https://example.com/checkout/success
# BILLING_CANCEL_URL=https://example.com/checkout/cancel

# ── Integration testing (optional) ───────────────────────────────────────────
# Set SERVER_URL to run integration tests against live API instead of local spawn
# SERVER_URL=https://api.example.com
# INTEGRATION_SERVER_WAIT_MS=12000
# INTEGRATION_SERVER_POLL_MS=200
# INTEGRATION_API_TIMEOUT_MS=6000
# INTEGRATION_API_MAX_RETRIES=2
# INTEGRATION_API_RETRY_DELAY_MS=250
