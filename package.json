{
  "name": "mdpage",
  "version": "1.0.0",
  "description": "One markdown file → one beautiful page",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:server\"",
    "dev:vite": "vite",
    "dev:server": "nodemon --watch server.js --watch lib/ --watch src/lib/ server.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server.js",
    "test": "node scripts/validate-publish.js",
    "test:backend": "node scripts/test-backend.js",
    "test:unit": "node --test tests/unit/slug-rules.test.js tests/unit/lifecycle.test.js tests/unit/view-dedup.test.js tests/unit/internal-stats.test.js tests/unit/internal-auth.test.js tests/unit/healthz.test.js tests/unit/lifecycle-ux.test.js",
    "test:phase1": "bash tests/run-qa.sh unit",
    "test:integration": "node scripts/test-integration.js",
    "test:integration:manual": "bash tests/run-qa.sh integration",
    "test:all": "node scripts/validate-publish.js && node scripts/test-backend.js && bash tests/run-qa.sh unit && node scripts/test-integration.js"
  },
  "keywords": [
    "markdown",
    "publishing",
    "typography"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^5.2.1",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.1.1",
    "markdown-it-footnote": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.3",
    "recharts": "^3.7.0"
  },
  "devDependencies": {
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.24",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "lucide-react": "^0.469.0",
    "nodemon": "^3.1.11",
    "postcss": "^8.5.6",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.1",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "vite": "^6.4.1"
  }
}
